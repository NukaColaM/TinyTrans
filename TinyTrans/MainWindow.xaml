<Window x:Class="TinyTrans.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TinyTrans"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI, Microsoft YaHei"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Closing="Window_Closing">
    <Border BorderBrush="{StaticResource WindowBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{StaticResource WindowBackground}"
            SnapsToDevicePixels="True">

        <Grid Margin="12,10,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ Row 1: Input Area ═══ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>

                <!-- Input text box (auto-grows to 5 lines, then scrolls) -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="3"
                        MinWidth="200">
                    <TextBox x:Name="InputTextBox"
                             MinHeight="28"
                             MaxHeight="116"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Hidden"
                             VerticalContentAlignment="Top"
                             FontSize="14"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="6,4"
                             Foreground="#333333"
                             ContextMenu="{x:Null}"
                             TextChanged="InputTextBox_TextChanged"
                             PreviewKeyDown="InputTextBox_PreviewKeyDown" />
                </Border>

                <!-- Translate button with spinner support -->
                <Button x:Name="TranslateButton"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        IsEnabled="False"
                        Click="TranslateButton_Click"
                        ToolTip="Translate (Ctrl+Enter)"
                        Style="{StaticResource IconButtonStyle}">
                    <Grid>
                        <!-- Normal translate icon (Bootstrap Icons) -->
                        <Viewbox x:Name="TranslateIconView"
                                 Stretch="Uniform"
                                 Margin="4"
                                 Visibility="Visible">
                            <Canvas Width="16" Height="16">
                                <Path Fill="#555555"
                                      Data="M4.545 6.714 4.11 8H3l1.862-5h1.284L8 8H6.833l-.435-1.286zm1.634-.736L5.5 3.956h-.049l-.679 2.022z" />
                                <Path Fill="#555555"
                                      Data="M0 2a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v3h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-3H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zm7.138 9.995q.289.451.63.846c-.748.575-1.673 1.001-2.768 1.292.178.217.451.635.555.867 1.125-.359 2.08-.844 2.886-1.494.777.665 1.739 1.165 2.93 1.472.133-.254.414-.673.629-.89-1.125-.253-2.057-.694-2.82-1.284.681-.747 1.222-1.651 1.621-2.757H14V8h-3v1.047h.765c-.318.844-.74 1.546-1.272 2.13a6 6 0 0 1-.415-.492 2 2 0 0 1-.94.31" />
                            </Canvas>
                        </Viewbox>
                        <!-- Spinner (shown during translation) -->
                        <TextBlock x:Name="SpinnerText"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="#555555"
                                   Text="⠋" />
                    </Grid>
                </Button>
            </Grid>

            <!-- Gap between rows -->
            <Rectangle Grid.Row="1" Height="8" Fill="Transparent" />

            <!-- ═══ Row 2: Output Area ═══ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>

                <!-- Output panel with background -->
                <Border Grid.Column="0"
                        Background="{StaticResource OutputBackground}"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="3"
                        MinWidth="200">
                    <Grid>
                        <!-- Output text box (read-only, selectable) -->
                        <TextBox x:Name="OutputTextBox"
                                 MinHeight="28"
                                 MaxHeight="116"
                                 TextWrapping="Wrap"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Hidden"
                                 VerticalContentAlignment="Top"
                                 FontSize="14"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="6,4"
                                 Foreground="#333333"
                                 ContextMenu="{x:Null}"
                                 TextChanged="OutputTextBox_TextChanged" />

                        <!-- Loading overlay (dimmed during translation) -->
                        <Border x:Name="LoadingOverlay"
                                Background="#D8EEEEEE"
                                Visibility="Collapsed"
                                CornerRadius="3"
                                IsHitTestVisible="False">
                            <Grid>
                                <TextBlock Text="Translating…"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#888888" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Copy button -->
                <Button x:Name="CopyButton"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        IsEnabled="False"
                        Click="CopyButton_Click"
                        ToolTip="Copy"
                        Style="{StaticResource IconButtonStyle}">
                    <Grid>
                        <Viewbox x:Name="CopyIconView"
                                 Stretch="Uniform"
                                 Margin="4"
                                 Visibility="Visible">
                            <Canvas Width="16" Height="16">
                                <Path Fill="#555555"
                                      Data="M4 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM2 5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1h1v1a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1v1z" />
                            </Canvas>
                        </Viewbox>
                        <Viewbox x:Name="CopyCheckView"
                                 Stretch="Uniform"
                                 Margin="4"
                                 Visibility="Collapsed">
                            <Canvas Width="16" Height="16">
                                <Path Fill="#228B22"
                                      Data="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425z" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
